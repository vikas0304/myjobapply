  title: string;

  description: string;

  location: {
    city?: string;
    state?: string;
    country?: string;
    remote?: boolean;
    workplaceType?: "remote" | "hybrid" | "onsite";
  };

  employmentType?: string;

  salary?: {
    min?: number;
    max?: number;
    currency?: string;
  };

  skills: string[];

  experience?: {
    min?: number;
    max?: number;
  };

