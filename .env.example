# ==============================================================================
# Database Configuration
# ==============================================================================

# Option 1: Local Docker PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myjobapply"

# Option 2: Supabase Cloud PostgreSQL
# Transaction mode pooler (recommended for serverless/BFF): port 6543
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Direct connection (for migrations and long-lived workers): port 5432
# DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# Local Docker Postgres Environment Variables
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myjobapply
POSTGRES_PORT=5432

# ==============================================================================
# Supabase API Keys (Optional, for Supabase Storage / Auth if used)
# ==============================================================================
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# AI Gateway & Providers
# ==============================================================================
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
