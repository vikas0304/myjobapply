```typescript
interface Job {
  id: string;

  source: {
    platform: string;
    sourceJobId?: string;
    url: string;
  };

  company: {
    id?: string;
    name: string;
    domain?: string;
    logo?: string;
  };

  title: string;
  description: string;

  location: {
    city?: string;
    state?: string;
    country?: string;
    remote?: boolean;
    workplaceType?: "remote" | "hybrid" | "onsite";
  };

